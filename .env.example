# Copie para .env e preencha valores privados antes de executar Docker Compose.
ENV=production
DB_PASSWORD=
SECRET_KEY=
SEED_ADMIN_EMAIL=admin@pizzaria.com
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=gerente@pizzaria.com
SEED_MANAGER_PASSWORD=
PUBLIC_BACKEND_URL=http://localhost:8001
# Para backend sem Compose: DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/pizzaria_checklist
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Senhas iniciais: pelo menos 12 caracteres; não reutilize as do GitHub/Google.
